{
  "name": "dsh-llm-sampling-params",
  "version": "0.2.0",
  "description": "DSH plugin: inject per-model sampling parameters (top_p, top_k, min_p, repeat_penalty/repetition_penalty, presence_penalty, frequency_penalty) into every chat-completions request sent to an OpenAI-compatible gateway (llama.cpp, SGLang, vLLM).",
  "author": "devhang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devhang/dsh-llm-sampling-params.git"
  },
  "homepage": "https://github.com/devhang/dsh-llm-sampling-params#readme",
  "bugs": {
    "url": "https://github.com/devhang/dsh-llm-sampling-params/issues"
  },
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "llama.cpp",
    "llama-server",
    "sglang",
    "vllm",
    "openai-compatible",
    "sampling",
    "top_p",
    "min_p",
    "repeat_penalty",
    "repetition_penalty"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
